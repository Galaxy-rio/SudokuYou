    <string name="game_hint_explanation_last_digit">%1$s 是%2$s唯一的空格，因此只能填入 %3$d。</string>
    <string name="game_hint_explanation_naked_single">%1$s 只剩一个候选数：%2$d。</string>
    <string name="game_hint_explanation_hidden_single">在%2$s中，候选数 %1$s 只能填在%3$s。</string>
    <string name="game_hint_explanation_naked_subset">在%1$s中，%2$s这 %4$d 格的候选数合起来只有 %3$s 这 %4$d 个数字。它们必须占满这几格，因此可以从%1$s的其余格中删除这些候选数。</string>
    <string name="game_hint_explanation_locked_subset">%2$s这 %4$d 格同时位于%1$s和%5$s，候选数合起来只有 %3$s 这 %4$d 个数字。它们必须占满这几格，因此可以从这两个区域的其余格中删除这些候选数。</string>
    <string name="game_hint_explanation_hidden_subset">在%1$s中，%2$s 这 %4$d 个数字只能填在%3$s这 %4$d 格。它们必须占满这几格，因此可以删除这些格中的其他候选数。</string>
    <string name="game_hint_explanation_pointing">在%2$s中，%1$s 的所有可能位置都在%3$s上。因此，%3$s中的 %1$s 必须位于这个宫内，可以删除该行或列在宫外的候选数 %1$s。</string>
    <string name="game_hint_explanation_claiming">在%2$s中，%1$s 的所有可能位置都在%3$s内。因此，%3$s中的 %1$s 必须位于这条行或列上，可以删除该宫在这条行或列以外的候选数 %1$s。</string>
    <string name="game_hint_explanation_fish">在%2$s中，%1$s 的所有可能位置都落在%3$s上。这两组行、列的数量相同，每条都必须恰好容纳一个 %1$s。因此，可以从%3$s中不属于%2$s的格子删除候选数 %1$s。</string>
    <string name="game_hint_explanation_finned_fish">观察候选数 %1$s：除%4$s中的鱼鳍外，%2$s与%3$s构成鱼形。如果任意鱼鳍填入 %1$s，就会排除标出的候选数；如果所有鱼鳍都不填 %1$s，剩下的鱼形也会排除它们。因此，这些候选数都可以删除。</string>
    <string name="game_hint_explanation_single_digit_chain">沿着%1$s中数字 %2$s 的链条推理：如果%3$s不成立，%4$s就必须成立，反过来也一样。因此，两端至少有一格填入 %2$s，可以从同时看见两端的格子中删除 %2$s。</string>
    <string name="game_hint_explanation_grouped_x_chain">沿数字 %1$s 的分组链，在［%2$s］与［%3$s］之间推理。把一组候选数视为一个节点：组中至少一个候选数成立时，这个节点就成立。两端至少有一组成立，因此可以从同时看见两端所有候选位置的格子中删除 %1$s。</string>
    <string name="game_hint_explanation_x_chain_loop">数字 %1$s 的链条经过%2$s，形成连续闭环。沿两个方向推理可知，每条弱链的两端也必须恰好有一端成立。因此，可以从环外同时看见某条弱链两端的格子中删除 %1$s。</string>
    <string name="game_hint_explanation_x_chain_one_endpoint">假设%1$s不填 %2$d，沿链条推理后却会得出该格必须填 %2$d，产生矛盾。因此，%1$s只能填 %2$d。</string>
    <string name="game_hint_explanation_w_wing">%1$s这两格都只有候选数 %2$s。它们不能同时填 %3$d，否则%4$s就没有位置可以填 %3$d。因此，这两格至少有一格填 %5$d，可以从同时看见它们的格子中删除 %5$d。</string>
    <string name="game_hint_explanation_multi_digit_chain">沿着%1$s中的双候选格推理：如果%2$s不成立，%3$s就必须成立，反过来也一样。因此，两端至少有一格填入 %4$d，可以从同时看见两端的格子中删除 %4$d。</string>
    <string name="game_hint_explanation_xyz_wing">%1$s这三格中，至少有一格必须填 %2$d。否则，两翼各自剩下的数字会排空枢轴格的候选数。因此，可以从同时看见枢轴和两翼的格子中删除 %2$d。</string>
    <string name="game_hint_explanation_wxyz_wing">%2$s这 %4$d 格只使用 %3$s。两个翼组仅共享 %1$d，且每个翼格都看见所有枢轴格。如果标出的格子填入 %1$d，剩下的数字就不足以填满这 %4$d 格。因此，可以从标出的格子中删除 %1$d。</string>
    <string name="game_hint_explanation_aic">沿着%1$s交替推理：如果%2$s不成立，%3$s就必须成立，反过来也一样。因此，这两个候选数至少有一个成立，可以删除同时与它们冲突的候选数。</string>
    <string name="game_hint_explanation_nishio_forcing">先假设%1$s成立。沿%2$s推理后，会出现棋盘上标出的矛盾。因此，这个假设不可能成立，可以删除该候选数。</string>
    <string name="game_hint_explanation_forcing_true_contradiction">假设%1$s成立。%2$s因此，该候选数不成立，可以删除。</string>
    <string name="game_hint_explanation_forcing_false_contradiction">假设%1$s不成立。%2$s因此，该候选数必须成立，应当填入这个数字。</string>
    <string name="game_hint_contradiction_opposite_truths">沿链条推理，却会得出%1$s既成立又不成立，产生矛盾。</string>
    <string name="game_hint_contradiction_empty_cell">沿链条推理，会使%1$s没有可填的候选数，产生矛盾。</string>
    <string name="game_hint_contradiction_empty_house">沿链条推理，会使%1$s中的某个必需数字没有可填的位置，产生矛盾。</string>
    <string name="game_hint_explanation_verity_forcing">%1$s逐一检查%2$s的所有可能情况。每个分支都得到棋盘上标出的同一结论，因此无论哪种情况成立，这个结论都成立。</string>
    <string name="game_hint_forcing_region_premise">%2$s中的候选数 %1$d</string>
    <string name="game_hint_explanation_remote_pair">相连的%1$s都只有候选数 %2$s。两种数字沿链条交替出现，因此链两端必须分别填入数对中的不同数字。同时看见两端的格子不能填这两个数字。</string>
    <string name="game_hint_explanation_chute_remote_pair">观察同一横向宫带或纵向宫列中的%1$s。数对 %2$s 在检查位置中的缺失，限制了这两个数字在三个宫中的分布。如果填入标出的候选数，其中一个宫就会缺少必需的数字，因此可以删除该候选数。</string>
    <string name="game_hint_explanation_coloring_type_1">把%2$s中相连的候选数 %1$s 交替染成两种颜色，其中必有一种颜色全部成立。标出的候选数同时看见两种颜色，无论哪种颜色成立都会与它冲突，因此可以删除。</string>
    <string name="game_hint_explanation_coloring_type_2">把%2$s中相连的候选数 %1$s 交替染成两种颜色。同色的两个候选数位于同一行、列或宫，不能同时成立。因此，这种颜色的所有候选数都不成立，可以删除。</string>
    <string name="game_hint_explanation_medusa_trap">把%1$s中的候选数按强链交替染成两种颜色：既连接双候选格内的两个数字，也连接某个数字在一个区域内仅有的两个位置。其中必有一种颜色全部成立。标出的候选数与两种颜色都冲突，因此可以删除。</string>
    <string name="game_hint_explanation_medusa_contradiction">%1$s中相连的候选数交替染成两种颜色。如果其中一种颜色全部成立，就会出现数字冲突，或使某格没有可填的候选数。因此，这种颜色不成立，另一种颜色成立，可以按标记填数和删数。</string>
    <string name="game_hint_explanation_sue_de_coq_type_1">交集中的%1$s只使用 %2$s。交集外，%3$s只有数对 %4$s，%5$s只有数对 %6$s，两个数对互不重叠。交集必须从每个数对中各取一个数字。因此，%4$s 被锁定在%7$s的标记格中，%6$s 被锁定在%8$s的标记格中，可以从各自区域的其余格中删除。</string>
    <string name="game_hint_explanation_sue_de_coq_type_2">交集中的%1$s只使用 %2$s。交集外，%3$s只有数对 %4$s，%5$s只有数对 %6$s，两个数对互不重叠。交集必须从每个数对中各取一个数字，并填入 %9$s。因此，%4$s 和 %9$s 被锁定在%7$s的标记格中；%6$s 和 %9$s 被锁定在%8$s的标记格中，可以从各自区域的其余格中删除。</string>
    <string name="game_hint_explanation_empty_rectangle">在%2$s中，%1$s 只可能位于%3$s或%4$s上。在%5$s中，%1$s 只能填在%6$s或%7$s。如果%7$s填 %1$s，就能直接排除%8$s中的 %1$s；否则，%6$s必须填 %1$s，使该宫的 %1$s 只能位于%4$s，同样排除%8$s中的 %1$s。</string>
    <string name="game_hint_explanation_bug_plus_one">这一步利用题目只有唯一解的条件。如果从%1$s删除 %2$d，所有未解格都会只剩两个候选数，每个区域内的每个未填数字也都只剩两个位置。这样的 BUG 结构不可能恰好只有一个解，因此%1$s必须填入 %2$d。</string>
    <string name="game_hint_explanation_unique_rectangle">%1$s利用题目只有唯一解的条件。%2$s中的矩形四角不能最终只填 %3$s，否则交换这两个数字就会得到第二个解。结合标出的候选数限制，可以作出所示删除。</string>
    <string name="game_hint_explanation_unique_rectangle_corner">%1$s利用题目只有唯一解的条件。%2$s中的三个角都只有候选数 %3$s。如果第四个角也填入这两个数字之一，就能在四角交换这两个数字，得到第二个解。因此，可以从第四个角删除数对中仍保留的候选数。</string>
    <string name="game_hint_explanation_unique_rectangle_extra">%1$s利用题目只有唯一解的条件。%2$s这四个角不能最终只填 %3$s，因此至少有一个角必须填入额外数字 %4$d。可以从同时看见所有含有该额外候选数的角的格子中删除 %4$d。</string>
    <string name="game_hint_explanation_unique_rectangle_subset">%1$s利用题目只有唯一解的条件。%2$s中的矩形至少有一个角必须填入 %3$s 以外的数字。把这些额外候选数视为一个必须占用的位置，与标出的辅助格一起组成数组，就能从同时看见这些位置的其他格中删除数组内的候选数。</string>
    <string name="game_hint_explanation_unique_rectangle_conjugate">%1$s利用题目只有唯一解的条件。在%2$s中，数对 %3$s 的一个数字被锁定在含有额外候选数的两个角。这两个角不能再填 %4$d，否则四角会形成可以互换数字的两个解。因此，可以从这两个角删除 %4$d。</string>
