    <string name="game_hint_explanation_last_digit">%1$s 是%2$s唯一的空格，因此只能填入 %3$d。</string>
    <string name="game_hint_explanation_naked_single">%1$s 只剩一个候选数：%2$d。</string>
    <string name="game_hint_explanation_hidden_single">在%2$s中，候选数 %1$s 只能填在%3$s。</string>
    <string name="game_hint_explanation_naked_subset">在%1$s中，%2$s只包含 %3$s；因此可从其他格中删除这些候选数。</string>
    <string name="game_hint_explanation_hidden_subset">在%1$s中，%2$s只可能出现在%3$s；因此可删除这些格中的其他候选数。</string>
    <string name="game_hint_explanation_pointing">在%2$s中，候选数 %1$s 只出现在%3$s；因此可从该行或列的其他格中删除它。</string>
    <string name="game_hint_explanation_claiming">在%2$s中，候选数 %1$s 只落在%3$s；因此可从该宫的其他格中删除它。</string>
    <string name="game_hint_explanation_fish">候选数 %1$s 在基础区域%2$s中只落在覆盖区域%3$s内，因此可从这些覆盖区域的其他格中删除它。</string>
    <string name="game_hint_explanation_single_digit_chain">%1$s 将候选数 %2$s 通过%3$s连接起来。强弱关系交替后，目标候选数不可能成立。</string>
    <string name="game_hint_explanation_multi_digit_chain">%1$s 使用相连的格子%2$s和候选数 %3$s；无论推理链哪一端成立，都会得到同一项删除结论。</string>
    <string name="game_hint_explanation_wxyz_wing">格子%2$s只使用四个候选数 %3$s，两个翼组仅共享候选数 %1$d。若目标格填入 %1$d，枢轴组占用的其余数字会同时从两翼排除，使翼格数量多于剩余可用数字，因此可删除该候选数。</string>
    <string name="game_hint_explanation_aic">%1$s 在格子%2$s中的候选数 %3$s 之间交替使用强链和弱链。链的两个端点至少一个为真，因此可删除同时与两端冲突的候选数。</string>
    <string name="game_hint_explanation_nishio_forcing">假设%1$s为真，会沿%2$s图得到棋盘上标出的矛盾，因此该假设为假。</string>
    <string name="game_hint_explanation_verity_forcing">%1$s从%2$s的每一种可能情况分别推理，所有分支都得到棋盘上标出的同一结论。</string>
    <string name="game_hint_forcing_region_premise">%2$s中的候选数 %1$d</string>
    <string name="game_hint_explanation_remote_pair">数对 %2$s 在%1$s之间交替出现，同时看见链两端的格子不能包含这两个数字。</string>
    <string name="game_hint_explanation_chute_remote_pair">%1$s中的带状远程数对将 %2$s 锁定在宫带或宫列中，从而得到所示删除结论。</string>
    <string name="game_hint_explanation_coloring_type_1">候选数 %1$s 的共轭链把%2$s交替染成两种颜色。目标格同时看见两种颜色，因此可删除该候选数。</string>
    <string name="game_hint_explanation_coloring_type_2">候选数 %1$s 的共轭链把%2$s交替染成两种颜色。同色的两个格子彼此可见，因此该颜色必为假。</string>
    <string name="game_hint_explanation_empty_rectangle">候选数 %1$s 通过%2$s中的共轭关系构成空矩形；两种可能都会排除目标候选数。</string>
